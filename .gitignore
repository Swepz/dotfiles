# Fish runtime state (machine-local universal variables and atomic-write leftovers)
fish_variables
fish_variables*

hypr/.config/hypr/monitors.lua

# DankMaterialShell regenerates these from the current wallpaper
hypr/.config/hypr/dms/
hypr/.config/hypr/hyprland.lua.backup*

# Generated by the copilot CLI
