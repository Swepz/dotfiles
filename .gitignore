# DankMaterialShell installs plugins from plugins.lock.json and generates these
dms/.config/DankMaterialShell/plugins/
dms/.config/DankMaterialShell/*.css
dms/.config/DankMaterialShell/.firstlaunch
dms/.config/DankMaterialShell/.changelog-*
gtk/.config/gtk-*/colors.css
gtk/.config/gtk-*/dank-colors.css
hypr/.config/hypr/colors.conf
hypr/.config/hypr/hyprland.lua.dmsbackup*
hypr/.config/hypr/monitors.lua.tmp*
