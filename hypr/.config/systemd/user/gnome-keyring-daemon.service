[Unit]
Description=GNOME Keyring daemon (SDDM autologin)
Requires=gnome-keyring-daemon.socket

[Service]
Type=simple
# SDDM autologin has no password token for PAM to pass to the login keyring.
# This keyring was initialized with a newline-only password, supplied here via
# stdin so it is unlocked without an interactive prompt at every login.
ExecStart=/usr/bin/gnome-keyring-daemon --foreground --unlock --components=pkcs11,secrets --control-directory=%t/keyring
StandardInput=data
StandardInputData=Cg==
StandardError=journal
Restart=on-failure

[Install]
Also=gnome-keyring-daemon.socket
WantedBy=default.target
