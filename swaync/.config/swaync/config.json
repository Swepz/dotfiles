{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 8,
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "control-center-width": 420,
  "control-center-height": 600,
  "notification-window-width": 380,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "notification-visibility": {
    "keep-critical": {
      "state": "enabled",
      "urgency": "Critical"
    },
    "keep-messages-and-mail-by-app-name": {
      "state": "enabled",
      "app-name": "(?i)vesktop|discord|signal|telegram|slack|element|whatsapp|evolution|thunderbird|geary|zen"
    },
    "keep-messages-and-mail-by-desktop-entry": {
      "state": "enabled",
      "desktop-entry": "(?i)vesktop|discord|signal|telegram|slack|element|whatsapp|evolution|thunderbird|geary|zen"
    },
    "popup-only-everything-else": {
      "state": "transient",
      "urgency": "Low|Normal"
    }
  },
  "widgets": [
    "title",
    "dnd",
    "notifications",
    "mpris",
    "volume"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "image-size": 96,
      "image-radius": 12
    },
    "volume": {
      "label": "󰕾"
    }
  }
}
