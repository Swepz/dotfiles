/* Synthwave '84 (hand-set; matugen is not regenerating this file) */
* {
    background: rgba(38, 35, 53, 0.85);
    primary: #ff7edb;
    primary-fixed: #ffd9f6;
    primary-fixed-dim: #ff7edb;
    on-primary: #262335;
    on-primary-fixed: #2e0a28;
    on-primary-fixed-variant: #7a3a6e;
    primary-container: #7a3a6e;
    on-primary-container: #ffd9f6;
    secondary: #36f9f6;
    secondary-fixed: #d6fbff;
    secondary-fixed-dim: #36f9f6;
    on-secondary: #262335;
    on-secondary-fixed: #062b2b;
    on-secondary-fixed-variant: #2f6b6b;
    secondary-container: #2f6b6b;
    on-secondary-container: #d6fbff;
    tertiary: #72f1b8;
    tertiary-fixed: #d9ffe9;
    tertiary-fixed-dim: #72f1b8;
    on-tertiary: #262335;
    on-tertiary-fixed: #062b1c;
    on-tertiary-fixed-variant: #2f6b52;
    tertiary-container: #2f6b52;
    on-tertiary-container: #d9ffe9;
    error: #fe4450;
    on-error: #262335;
    error-container: #5c1a2b;
    on-error-container: #ffd6dc;
    surface: #262335;
    on-surface: #f8f8f2;
    on-surface-variant: #848bbd;
    outline: #848bbd;
    outline-variant: #463465;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #f8f8f2;
    inverse-on-surface: #262335;
    inverse-primary: #6d77b3;
    surface-dim: #1f1b2e;
    surface-bright: #3b3052;
    surface-container-lowest: #1a1626;
    surface-container-low: #221d33;
    surface-container: #2a2440;
    surface-container-high: #322a4a;
    surface-container-highest: #3b3052;

    border-width: 2px;
    border-radius: 12px;
    current-image: none;
}
