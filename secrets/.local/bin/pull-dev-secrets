#!/usr/bin/env bash
set -euo pipefail

account_file="$HOME/workspace/ws-osvoid/osvoid/account.env"
webhook_file="$HOME/.config/osvoid-discord/staff-webhook"
account_keys=(JX_SESSION_ID JX_CHARACTER_ID SECOND_CHARACTER_ID)

token="$(secret-tool lookup service bws account dev)" || {
    echo "read the bws dev access token from the keyring: not stored, run store-bws-token" >&2
    exit 1
}
secrets="$(BWS_ACCESS_TOKEN="$token" bws secret list --color no --output json)"
unset token

value() {
    jq -er --arg key "$1" 'map(select(.key == $key)) | if length == 1 then .[0].value else error("\(length) secrets named \($key)") end' <<<"$secrets" || {
        echo "read secret $1 from the dev project: missing or duplicated" >&2
        exit 1
    }
}

umask 077
mkdir -p "$(dirname "$webhook_file")"
account=""
for key in "${account_keys[@]}"; do
    account+="$key=$(value "$key")"$'\n'
done
webhook="$(value STAFF_WEBHOOK_URL)"
printf '%s' "$account" >"$account_file"
printf '%s\n' "$webhook" >"$webhook_file"
echo "wrote $account_file and $webhook_file"
